#!/bin/busybox sh
# What busybox init runs once, before it starts the agent: the kernel's
# filesystems, the modules the initramfs carries, then what the host asked
# for on the kernel command line (vz.shares, vz.rosetta, vz.net).
/bin/busybox --install -s /bin
export PATH=/bin
mount -t proc proc /proc
mount -t sysfs sys /sys
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /dev/shm
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /tmp
mount -t cgroup2 cgroup2 /sys/fs/cgroup
while read -r m; do
	insmod "/lib/modules/$m" || echo "rc: insmod $m failed"
done < /lib/modules/load.list
hostname gvx-vz
ip link set lo up

shares= rosetta= rosettad= net=
for arg in $(cat /proc/cmdline); do
	case "$arg" in
	vz.shares=*) shares=${arg#vz.shares=} ;;
	vz.rosetta=*) rosetta=${arg#vz.rosetta=} ;;
	vz.rosettad=1) rosettad=1 ;;
	vz.net=1) net=1 ;;
	esac
done

# Each share is a virtiofs tag, mounted at /mnt/<tag>.
for s in $(echo "$shares" | tr , ' '); do
	tag=${s%:ro}
	opt=rw
	[ "$tag" != "$s" ] && opt=ro
	mkdir -p "/mnt/$tag"
	mount -t virtiofs -o "$opt" "$tag" "/mnt/$tag" || echo "rc: mount $tag failed"
done

# Rosetta is a share too, of one directory holding the translator. The
# line is the registration Apple documents ("Running Intel Binaries in
# Linux VMs with Rosetta": update-binfmts --install rosetta … --magic …
# --mask … --credentials yes --preserve no --fix-binary yes), as
# binfmt_misc itself takes it: C is credentials, F is fix-binary, which
# opens the translator now so that it is found from any chroot or mount
# namespace later.
if [ -n "$rosetta" ]; then
	mkdir -p /mnt/rosetta
	mount -t virtiofs "$rosetta" /mnt/rosetta || echo "rc: mount rosetta failed"
	mount -t binfmt_misc binfmt_misc /proc/sys/fs/binfmt_misc
	printf '%s' ':rosetta:M::\x7fELF\x02\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x3e\x00:\xff\xff\xff\xff\xff\xfe\xfe\x00\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff\xff:/mnt/rosetta/rosetta:CF' \
		> /proc/sys/fs/binfmt_misc/register || echo "rc: binfmt registration failed"
	# With VZLinuxRosettaCachingOptions set by the host, the translator
	# asks this daemon for translations it has already made.
	if [ -n "$rosettad" ]; then
		mkdir -p /run/rosettad
		/mnt/rosetta/rosettad daemon /run/rosettad > /run/rosettad.log 2>&1 &
	fi
fi

if [ -n "$net" ]; then
	ip link set eth0 up
	udhcpc -i eth0 -s /etc/udhcpc.sh -q -n -t 20 -T 1 >/dev/null 2>&1 &
fi
echo "VZ-RC-DONE uptime=$(cut -d' ' -f1 /proc/uptime)"
